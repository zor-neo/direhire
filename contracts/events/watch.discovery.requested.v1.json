{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://direhire.example/contracts/events/watch.discovery.requested.v1.json",
  "title": "Watch discovery requested event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "correlation_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt_[a-f0-9]{32}$" },
    "event_type": { "const": "watch.discovery.requested" },
    "schema_version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "watch_id", "owner_id"],
      "properties": {
        "run_id": { "type": "string", "format": "uuid" },
        "watch_id": { "type": "string", "format": "uuid" },
        "owner_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}

