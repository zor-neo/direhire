DIREHIRE_ENVIRONMENT=development
DIREHIRE_DATABASE_URL=postgresql+psycopg://direhire:direhire@localhost:5432/direhire
# Production may use DIREHIRE_DATABASE_URL_PARAMETER=/prod/database/neon/pooled-url instead.
DIREHIRE_CORS_ORIGINS=["http://localhost:3000"]
DIREHIRE_ALLOW_INSECURE_DEV_AUTH=true
NEXT_PUBLIC_DEV_USER_ID=11111111-1111-4111-8111-111111111111
# Required in production for Cognito Authorization Code + PKCE:
# DIREHIRE_COGNITO_DOMAIN=https://your-domain.auth.ap-southeast-1.amazoncognito.com
# DIREHIRE_COGNITO_USER_POOL_ID=ap-southeast-1_example
# DIREHIRE_COGNITO_CLIENT_ID=example
# DIREHIRE_COGNITO_REDIRECT_URI=https://api.example.com/api/v1/auth/callback
# DIREHIRE_FRONTEND_POST_LOGIN_URL=https://app.example.com
# Production requires a JSON event-type to SQS URL map in DIREHIRE_QUEUE_ROUTES.
# USAJOBS is hidden until a registered API key and its matching contact email are stored in SSM:
# DIREHIRE_USAJOBS_ENABLED=true
# DIREHIRE_USAJOBS_API_KEY_PARAMETER=/prod/sources/usajobs/api-key
# DIREHIRE_USAJOBS_USER_AGENT_PARAMETER=/prod/sources/usajobs/user-agent
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
